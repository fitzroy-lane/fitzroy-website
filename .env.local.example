# Sanity CMS — create a new project at sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API token — for write access (get from sanity.io/manage > API > Tokens)
SANITY_API_TOKEN=

# Resend email API key — for enquiry form emails (resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=catering@fitzroylane.com
